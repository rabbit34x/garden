{% if pluginSettings.showFooter %}
  {% set rabbit34FooterCommit = pluginSettings.commitSha | rabbit34FooterCommit %}
  <footer class="content rabbit34-footer" aria-label="Site footer">
    <div class="rabbit34-footer__inner">
      <span>© 2026 kn_iidx</span>
      <a href="https://rabbit34.org/">rabbit34.org</a>
      <a href="https://github.com/rabbit34x/garden">rabbit34x/garden</a>
      {% if rabbit34FooterCommit %}
        <span>Commit <a href="{{ rabbit34FooterCommit.url | escape }}">{{ rabbit34FooterCommit.short | escape }}</a></span>
      {% endif %}
    </div>
  </footer>
{% endif %}
